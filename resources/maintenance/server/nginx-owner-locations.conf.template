location = {{owner_login_path}} {
    auth_basic "{{owner_auth_realm}}";
    auth_basic_user_file /etc/nginx/secure/mpfc-maintenance-owner.htpasswd;
    alias /var/www/furniture-maintenance/owner-access.html;
    default_type text/html;
    charset utf-8;
    add_header Cache-Control "no-store" always;
    add_header X-Robots-Tag "noindex, nofollow, noarchive" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header Set-Cookie $mpfc_maintenance_owner_set_cookie always;
    access_log off;
}

location = {{owner_logout_path}} {
    alias /var/www/furniture-maintenance/owner-logout.html;
    default_type text/html;
    charset utf-8;
    add_header Cache-Control "no-store" always;
    add_header X-Robots-Tag "noindex, nofollow, noarchive" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header Set-Cookie "{{owner_cookie_name}}=; Path=/; Max-Age=0; Secure; HttpOnly; SameSite=Strict" always;
    access_log off;
}
